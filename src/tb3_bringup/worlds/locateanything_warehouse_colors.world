<?xml version="1.0"?>
<!-- Color/instance warehouse scene, derived from the course warehouse room.
     White chair: northeast corner; black chair: middle of the east side.
     Green table: northwest corner; blue table: middle of the south side.
     People: room centre and southwest corner, with clearance from other targets.
     The launcher chooses a safe random spawn; exploration supplies history views.
     Environment poses are never inputs to target selection or semantic memory.
     Chair mesh attribution: VisitorChair, Wan Yi Seow / Open Robotics, CC BY 4.0.
     People, sun and ground retain the existing repository NOTICE provenance.
     Tables are original visible SDF primitives, with identical collision shapes.
     No runtime acceptance or model-grounding accuracy is implied by this file. -->
<sdf version="1.6">
  <world name="locateanything_warehouse_colors">
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>
    <physics type="ode"><real_time_factor>1.0</real_time_factor><max_step_size>0.001</max_step_size></physics>
    <scene><ambient>0.5 0.5 0.5 1</ambient><background>0.7 0.75 0.8 1</background></scene>
    <gui><camera name="user_camera"><pose>0 0 10 0 1.57079632679 0</pose><view_controller>orbit</view_controller></camera></gui>
    <!-- Optional state service is for post-hoc evaluation only. -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/gazebo</namespace></ros><update_rate>10</update_rate>
    </plugin>
    <!-- Six-by-eight metre walkable warehouse interior. -->
    <model name="la_colors_wall_east"><static>true</static><pose>3.1 0 1.25 0 0 0</pose>
      <link name="body">
      <collision name="wall_collision"><pose>0 0 0 0 0 0</pose><geometry><box><size>0.2 8.4 2.5</size></box></geometry></collision>
      <visual name="wall_visual"><pose>0 0 0 0 0 0</pose><geometry><box><size>0.2 8.4 2.5</size></box></geometry>
        <material><ambient>0.57 0.59 0.62 1</ambient><diffuse>0.57 0.59 0.62 1</diffuse><specular>0.04 0.04 0.04 1</specular></material>
      </visual>
      </link>
    </model>
    <model name="la_colors_wall_west"><static>true</static><pose>-3.1 0 1.25 0 0 0</pose>
      <link name="body">
      <collision name="wall_collision"><pose>0 0 0 0 0 0</pose><geometry><box><size>0.2 8.4 2.5</size></box></geometry></collision>
      <visual name="wall_visual"><pose>0 0 0 0 0 0</pose><geometry><box><size>0.2 8.4 2.5</size></box></geometry>
        <material><ambient>0.57 0.59 0.62 1</ambient><diffuse>0.57 0.59 0.62 1</diffuse><specular>0.04 0.04 0.04 1</specular></material>
      </visual>
      </link>
    </model>
    <model name="la_colors_wall_north"><static>true</static><pose>0 4.1 1.25 0 0 0</pose>
      <link name="body">
      <collision name="wall_collision"><pose>0 0 0 0 0 0</pose><geometry><box><size>6.4 0.2 2.5</size></box></geometry></collision>
      <visual name="wall_visual"><pose>0 0 0 0 0 0</pose><geometry><box><size>6.4 0.2 2.5</size></box></geometry>
        <material><ambient>0.57 0.59 0.62 1</ambient><diffuse>0.57 0.59 0.62 1</diffuse><specular>0.04 0.04 0.04 1</specular></material>
      </visual>
      </link>
    </model>
    <model name="la_colors_wall_south"><static>true</static><pose>0 -4.1 1.25 0 0 0</pose>
      <link name="body">
      <collision name="wall_collision"><pose>0 0 0 0 0 0</pose><geometry><box><size>6.4 0.2 2.5</size></box></geometry></collision>
      <visual name="wall_visual"><pose>0 0 0 0 0 0</pose><geometry><box><size>6.4 0.2 2.5</size></box></geometry>
        <material><ambient>0.57 0.59 0.62 1</ambient><diffuse>0.57 0.59 0.62 1</diffuse><specular>0.04 0.04 0.04 1</specular></material>
      </visual>
      </link>
    </model>
    <!-- Painted loading-door panel decorates the existing solid west wall. -->
    <model name="la_colors_loading_door"><static>true</static><pose>-2.985 0 1.05 0 0 0</pose>
      <link name="body"><visual name="panel">
        <geometry><box><size>0.02 2.4 2.1</size></box></geometry>
        <material><ambient>0.22 0.25 0.29 1</ambient><diffuse>0.30 0.34 0.38 1</diffuse></material>
      </visual></link>
    </model>
    <include><uri>model://la_colors_white_chair</uri><name>la_colors_white_chair</name>
      <pose>2.1 3.1 0 0 0 -1.00000000</pose><static>true</static>
    </include>
    <include><uri>model://la_colors_black_chair</uri><name>la_colors_black_chair</name>
      <pose>2.1 0 0 0 0 -1.00000000</pose><static>true</static>
    </include>
    <include><uri>model://la_colors_green_table</uri><name>la_colors_green_table</name>
      <pose>-1.95 3.15 0 0 0 0.00000000</pose><static>true</static>
    </include>
    <include><uri>model://la_colors_blue_table</uri><name>la_colors_blue_table</name>
      <pose>0 -3.15 0 0 0 0.00000000</pose><static>true</static>
    </include>
    <include><uri>model://person_standing</uri><name>la_colors_person_left</name>
      <pose>0 0 0 0 0 -2.37702481</pose><static>true</static>
    </include>
    <include><uri>model://person_standing</uri><name>la_colors_person_right</name>
      <pose>-2.1 -3.1 0 0 0 2.37702481</pose><static>true</static>
    </include>
  </world>
</sdf>
